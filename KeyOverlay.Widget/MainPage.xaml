<Page
    x:Class="KeyOverlay.Widget.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource ColorPaperBrush}">
    <Grid Padding="32">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="KEY OVERLAY" FontFamily="{StaticResource FontDisplay}" FontSize="14" Foreground="{StaticResource ColorAccentBrush}" />
            <TextBlock Text="Game Bar에서 오버레이를 여세요." Style="{StaticResource DisplayTextStyle}" TextWrapping="Wrap" />
            <TextBlock Text="Win + G를 누른 뒤 위젯 메뉴에서 Key Overlay를 선택합니다. 핀 버튼을 눌러 고정하면 독점 전체화면 게임 위에도 계속 표시됩니다." Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
            <Border Background="{StaticResource ColorSurfaceBrush}" BorderBrush="{StaticResource ColorRuleBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="사용 순서" FontWeight="SemiBold" />
                    <TextBlock Text="1. Win + G → 위젯 메뉴 → Key Overlay" />
                    <TextBlock Text="2. 위젯 제목 표시줄의 핀을 켬" />
                    <TextBlock Text="3. 클릭 통과를 끈 상태에서 키 버튼 사용" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
